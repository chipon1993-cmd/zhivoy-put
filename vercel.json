{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": { "api/admin.js": { "includeFiles": "{admin/**,node_modules/dompurify/dist/purify.min.js}" } },
  "rewrites": [
    { "source": "/admin", "destination": "/api/admin" },
    { "source": "/admin/:file*", "destination": "/api/admin?file=:file*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'self'" }
    ] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/pages/confirm(.*)", "headers": [
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Cache-Control", "value": "no-store" }
    ] },
    { "source": "/pages/generated/:path*", "headers": [
      { "key": "Content-Security-Policy", "value": "sandbox allow-same-origin; default-src 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https: data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'" }
    ] }
  ]
}
